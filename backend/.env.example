# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/electricity_bill

# JWT
JWT_SECRET_KEY=change-this-secret
JWT_EXPIRE_MINUTES=1440

# Email Settings
# Mode: console (print to console only) or smtp (send real email)
EMAIL_MODE=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail_address@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
SENDER_EMAIL=your_gmail_address@gmail.com
SENDER_NAME=Điện nhà mình

# Để test gửi email thật, đổi EMAIL_MODE=smtp và điền thông tin Gmail:
# 1. Tạo App Password tại: https://myaccount.google.com/apppasswords
# 2. Điền SMTP_USERNAME = email Gmail của bạn
# 3. Điền SMTP_PASSWORD = App Password vừa tạo (16 ký tự)
# 4. Điền SENDER_EMAIL = email Gmail của bạn
